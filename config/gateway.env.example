# veltria-genmedia config
# Lives at: ~/.config/veltria-genmedia/gateway.env
# Permissions: chmod 600 (read by owner only)

# --- Required ---
GATEWAY_BASE_URL=https://your-gateway.example.com
GATEWAY_API_KEY=REPLACE_WITH_YOUR_VIRTUAL_KEY

# Auth header. Most LiteLLM / OpenRouter / similar gateways accept x-api-key.
# Some setups require Authorization: Bearer …  — set this to "authorization" then.
AUTH_HEADER=x-api-key

# --- Defaults (per-call overridable) ---
# Set these to whatever your gateway routes to. Leave blank to require caller
# to specify the model on every invocation.
DEFAULT_IMAGE_MODEL=
DEFAULT_VIDEO_MODEL=
DEFAULT_TEXT_MODEL=

# Where generated files land on your machine
DEFAULT_IMAGE_OUTPUT_DIR=$HOME/Pictures/genmedia
DEFAULT_VIDEO_OUTPUT_DIR=$HOME/Movies/genmedia

# Optional: a free-form string prepended to every image prompt (skippable per-call
# with raw=true). Use for consistent brand cues without typing them each time.
# Example:
#   BRAND_PRESET=Brand: Acme Corp. Palette — navy #002040 and gold #FFC107, clean editorial aesthetic.
BRAND_PRESET=

# --- Behavior ---
# Timeout for image gen (seconds)
IMAGE_TIMEOUT=120
# Timeout for video gen (some providers take several minutes)
VIDEO_TIMEOUT=600
# Retries on transient gateway errors
MAX_RETRIES=2
